{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/main.py" },
    { "source": "/(.*)", "destination": "/node_expo_tfg/$1" }
  ],
  "builds": [
    {
      "src": "node_expo_tfg/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ]
}