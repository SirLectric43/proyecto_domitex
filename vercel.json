{
  "version": 2,
  "builds": [
    {
      "src": "node_expo_tfg/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "backend/main.py" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/node_expo_tfg/$1" 
    }
  ],
  "cleanUrls": true
}